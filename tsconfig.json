{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@paginas/*": ["./src/paginas/*"],
      "@dados/*": ["./src/dados/*"],
      "@suporte/*": ["./src/suporte/*"]
    },
    "types": ["node"]
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
